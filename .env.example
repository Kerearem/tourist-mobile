# Mock backend (true) veya gerçek API (false)
EXPO_PUBLIC_USE_MOCK_BACKEND=false

# API base URL — cihaza göre değiştir:
# iOS Simulator:     http://localhost:4000/api/v1
# Android Emulator:  http://10.0.2.2:4000/api/v1
# Fiziksel cihaz:    http://<BILGISAYAR_IP>:4000/api/v1  (örn. http://192.168.1.42:4000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Cloudinary unsigned upload (profil fotoğrafı vb.)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
