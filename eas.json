{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourist-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_USE_MOCK_BACKEND": "false",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "dp2odxbwe",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "hvqlcate"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourist-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_USE_MOCK_BACKEND": "false",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "dp2odxbwe",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "hvqlcate"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tourist-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_USE_MOCK_BACKEND": "false",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "dp2odxbwe",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "hvqlcate"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
