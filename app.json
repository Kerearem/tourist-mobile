{
  "expo": {
    "name": "tourist-mobile",
    "slug": "tourist-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tourist-logo.png",
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.tourist-mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera, cevredeki yerleri ve deneyimleri cekebilmen icin kullanilir.",
        "NSPhotoLibraryUsageDescription": "Albumden fotograf ve video secip paylasabilmen icin erisim gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Cektigin fotograf ve videolari albumune kaydedebilmek icin erisim gerekir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/tourist-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}